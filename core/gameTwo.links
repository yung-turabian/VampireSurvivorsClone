            jsSave(ctx);
            jsTranslate(ctx, drawOffset.x, drawOffset.y);

            # could also draw the static stuff statically -- predraw on a hidden canvas, then display that every frame
            # draw the connections between planets
            #jsBeginPath(ctx);
